{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "HabitGlo",
    "version": "1.0.0"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop",
    "devPath": "http://localhost:4173/app",
    "distDir": "../dist-desktop"
  },
  "tauri": {
    "windows": [
      {
        "label": "main",
        "title": "HabitGlo",
        "width": 560,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "HabitGlo Overlay",
        "width": 1600,
        "height": 96,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "skipTaskbar": true,
        "url": "overlay.html"
      }
    ],
    "bundle": {
      "identifier": "com.habitglo.app",
      "active": true,
      "targets": "msi",
      "windows": {
        "digestAlgorithm": "sha256"
      },
      "icon": [
        "icons/icon.ico",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": "default-src 'self' tauri://* data: blob:; script-src 'self' tauri://* https://cdn.paddle.com https://*.posthog.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cdn.paddle.com https://checkout.paddle.com https://sandbox-checkout.paddle.com https://habitglo.com https://*.posthog.com ws://localhost:*; worker-src blob:"
    },
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      },
      "shell": {
        "open": true
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQ0RGNEM5Mzc2NzIyMzEKUldReEltYzN5ZlROTUVkUS9MSE9wbDc3YXpLcXBFOXJRSWdad3VEUXBqK0QrSXYraXR6ZHhwSksK",
      "endpoints": [
        "https://github.com/hwan18/HabitGlo/releases/latest/download/latest.json"
      ]
    }
  }
}
